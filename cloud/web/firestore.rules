rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in user (Google sign-in) can watch factory runs; only server/CLI credentials write.
    match /runs/{runId} {
      allow read: if request.auth != null;
      match /events/{eventId} {
        allow read: if request.auth != null;
      }
    }
    match /{document=**} {
      allow write: if false;
    }
  }
}
